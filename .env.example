# Safe local defaults; copy this file to .env and change values as needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Empty = no cross-origin browser access. Add exact origins, comma-separated.
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
JSON_BODY_LIMIT=16384
# Keep false locally. Behind a known proxy, use its exact IP or CIDR range.
TRUST_PROXY=false
